# Cloudinary Configuration for Leave Attachments
# Get these values from your Cloudinary dashboard: https://cloudinary.com/console

# Your Cloudinary cloud name
VITE_CLOUDINARY_CLOUD_NAME=dmtq51eg0

# Instructions:
# 1. Sign up for a free Cloudinary account at https://cloudinary.com
# 2. Go to your Dashboard
# 3. Copy your "Cloud name" 
# 4. Create an upload preset:
#    - Go to Settings > Upload
#    - Scroll to "Upload presets"
#    - Click "Add upload preset"
#    - Name it: leave_attachments
#    - Set Signing Mode to: Unsigned
#    - Set Folder to: nexon-attendo/leave-requests
#    - Save
# 5. Add VITE_CLOUDINARY_CLOUD_NAME to your .env file
# 6. Restart your development server
