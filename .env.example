# Supabase Configuration (REQUIRED)
# Get these from your Supabase project settings at: https://app.supabase.com/project/[project-id]/settings/api
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here
VITE_SUPABASE_SERVICE_KEY=your-service-role-key-here

# Non-VITE environment variables (for Vercel API routes and backend)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Email Notifications (OPTIONAL)
# For sending email reports and notifications via Resend
# Get API key from: https://resend.com/keys
RESEND_API_KEY=your-resend-api-key

# Email Configuration
REPORT_FROM_EMAIL=admin@yourdomain.com
DEFAULT_HR_EMAIL=hr-team@yourdomain.com

# SMS Notifications (OPTIONAL)
# For SMS alerts and notifications via Twilio
# Get credentials from: https://www.twilio.com/console
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+1234567890
TWILIO_WHATSAPP_NUMBER=whatsapp:+1234567890

# Google Calendar Integration (OPTIONAL)
# For automated holiday synchronization from Google Calendar
# Get API key from: https://console.cloud.google.com/
GOOGLE_CALENDAR_API_KEY=your-google-calendar-api-key

# Cloudinary Configuration (OPTIONAL)
# For photo storage and management
# Get cloud name from: https://cloudinary.com/console
VITE_CLOUDINARY_CLOUD_NAME=your-cloud-name

# ============================================================================
# DEPLOYMENT INSTRUCTIONS FOR VERCEL
# ============================================================================
#
# 1. LOCAL DEVELOPMENT (.env.local):
#    - Copy this file: cp .env.example .env.local
#    - Fill in all your actual values
#    - NEVER commit .env.local to Git
#
# 2. VERCEL PRODUCTION:
#    a. Go to: Vercel Dashboard > Your Project > Settings > Environment Variables
#    b. Add each variable with its actual value:
#       - VITE_SUPABASE_URL
#       - VITE_SUPABASE_ANON_KEY
#       - VITE_SUPABASE_SERVICE_KEY
#       - SUPABASE_URL
#       - SUPABASE_ANON_KEY
#       - SUPABASE_SERVICE_ROLE_KEY
#       - (Optional: RESEND_API_KEY, TWILIO_*, GOOGLE_CALENDAR_API_KEY)
#
#    c. Set them for: Production, Preview, Development environments
#    d. Redeploy your project after adding variables
#
# REQUIRED VARIABLES (minimum for app to work):
# - VITE_SUPABASE_URL
# - VITE_SUPABASE_ANON_KEY
# - SUPABASE_SERVICE_ROLE_KEY
#
# OPTIONAL VARIABLES (for specific features):
# - RESEND_API_KEY (for email functionality)
# - TWILIO_ACCOUNT_SID, TWILIO_AUTH_TOKEN, TWILIO_PHONE_NUMBER (for SMS)
# - GOOGLE_CALENDAR_API_KEY (for holiday sync)
# - VITE_CLOUDINARY_CLOUD_NAME (for photo uploads)
#
# NOTE: Never hardcode credentials in code. Always use environment variables.

