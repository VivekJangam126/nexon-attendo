# ============================================================
# PRODUCTION ENVIRONMENT VARIABLES
# Copy these to Vercel Dashboard > Settings > Environment Variables
# NEVER put real credentials in this file
# ============================================================

# Supabase Configuration (REQUIRED)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here
VITE_SUPABASE_SERVICE_KEY=your-service-role-key-here

# Non-VITE versions for Vercel serverless API routes (REQUIRED)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Email Notifications via Resend (OPTIONAL)
RESEND_API_KEY=your-resend-api-key

# SMS Notifications via Twilio (OPTIONAL)
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+1234567890
TWILIO_WHATSAPP_NUMBER=whatsapp:+1234567890

# Google Calendar Integration (OPTIONAL)
GOOGLE_CALENDAR_API_KEY=your-google-calendar-api-key

# Cloudinary Photo Storage (OPTIONAL)
VITE_CLOUDINARY_CLOUD_NAME=your-cloud-name

# Email Report Configuration
REPORT_FROM_EMAIL=admin@yourdomain.com
DEFAULT_HR_EMAIL=hr@yourdomain.com
